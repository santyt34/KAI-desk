# ============================================================
# Troko-Desk / KAI – Environment Configuration Example
# ============================================================

# --- Identity & App -----------------------------------------------------
APP_NAME=Troko
APP_ALIAS=KAI
WAKE_WORD=troko
WAKE_WORD_ALIAS=kai

# --- AI / LLM (Offline First + Hybrid Fallback) -------------------------
LLM_MODE=local
LOCAL_LLM_ENGINE=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Optional llama.cpp local direct model (downloadable Llama 3.2 3B GGUF)
LLAMA_MODEL_PATH=models/llama-3.2-3b-instruct-q4_k_m.gguf

# Optional Online Fallback (OpenAI, OpenRouter, Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Wake-Word (Vosk local Spanish / English) ---------------------------
VOSK_MODEL_PATH=vosk-model-es-0.42

# --- STT (faster-whisper) ----------------------------------------------
WHISPER_MODEL=base
WHISPER_DEVICE=auto

# --- TTS (Local Kokoro / Edge-TTS / Piper) ------------------------------
TTS_ENGINE=edge-tts
TTS_VOICE=es-MX-DaliaNeural
TTS_ENABLED=true
KOKORO_MODEL_DIR=models/kokoro

# --- UI & Animation (60 FPS Procedural Island) --------------------------
UI_FPS=60
UI_WIDTH=380
UI_HEIGHT=84
UI_EXPANDED_HEIGHT=150
UI_OPACITY=0.95
UI_ACCENT_COLOR=#7F5AF0

# --- Habits & Productivity ---------------------------------------------
POMODORO_WORK_MINUTES=25
POMODORO_BREAK_MINUTES=5
DAILY_WATER_TARGET=8

# --- Email Drafts (Safe Review Mode) -----------------------------------
EMAIL_DRAFT_MODE=true
MOCK_EMAIL_RECIPIENT=amigo@ejemplo.com

# --- Allowed App Launchers ----------------------------------------------
ALLOWED_APPS=notepad,calculator,explorer,chrome,code,spotify,discord,edge,brave,wordpad,cmd,powershell

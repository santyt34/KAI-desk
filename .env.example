# ============================================================
# KAI-Desk – Environment Configuration Example
# Copy this file to .env and fill in your values.
# ============================================================

# --- AI / LLM -----------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional online fallback (leave blank to disable)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Hybrid mode: "local" | "hybrid" | "online"
LLM_MODE=local

# --- Wake-Word ----------------------------------------------------------
WAKE_WORD=kai
# Sensitivity 0.0–1.0 (pvporcupine) or threshold (vosk)
WAKE_WORD_SENSITIVITY=0.5

# --- STT ----------------------------------------------------------------
# Model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
# Device: cpu | cuda | auto
WHISPER_DEVICE=auto

# --- TTS ----------------------------------------------------------------
# Engine: edge-tts | piper | none
TTS_ENGINE=edge-tts
TTS_VOICE=es-MX-DaliaNeural
TTS_ENABLED=true

# --- UI -----------------------------------------------------------------
UI_FPS=60
UI_WIDTH=360
UI_HEIGHT=80
UI_OPACITY=0.95
# Accent colour (hex)
UI_ACCENT_COLOR=#7F5AF0

# --- Paths & Storage ----------------------------------------------------
STORAGE_DIR=storage
DB_PATH=storage/kai.db
UNDO_HISTORY_PATH=storage/undo_history.json
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Desktop Organizer --------------------------------------------------
DESKTOP_PATH=
ORGANIZED_ROOT=~/Documents/KAI_Organized

# --- Productivity -------------------------------------------------------
POMODORO_WORK_MINUTES=25
POMODORO_BREAK_MINUTES=5

# --- Allowed App Launchers (comma-separated display names) ---------------
ALLOWED_APPS=notepad,calculator,explorer,chrome,code,spotify
